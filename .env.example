# ============================================================
# TOBFest Photobooth — Fedora Local Server
# Salin file ini menjadi .env, lalu ganti nilai yang diperlukan.
# ============================================================

# Keamanan dashboard operator (dibaca saat npm run build)
VITE_OPERATOR_PIN=ganti-dengan-pin-operator
VITE_OPERATOR_TOKEN=ganti-dengan-token-lokal-yang-panjang

# Jumlah foto per sesi photobooth. Default 4; bisa diubah ke 2/3/5 sesuai frame.
VITE_PHOTO_COUNT=4
# Alias kompatibel lama:
PHOTO_BOOTH_SHOT_COUNT=4

# Alamat server lokal Fedora
HOSTNAME=0.0.0.0
PORT=3000

# Origin publik saat aplikasi berada di belakang Cloudflare Tunnel + Caddy.
# Isi tanpa trailing slash. Kosongkan untuk akses HTTPS langsung melalui IP lokal.
PUBLIC_ORIGIN=

# Docker di Fedora. Samakan dengan output `id -u` dan `id -g`.
APP_UID=1000
APP_GID=1000

# Container memakai network host agar CUPS tetap hanya perlu listen di localhost.
CUPS_SERVER=127.0.0.1:631

# Queue fallback CUPS — harus sama persis dengan output: lpstat -p -d
PRINTER_NAME=EpsonL3251
PRINT_TEMP_DIR=/tmp/photobooth-print
MAX_PRINT_FILE_MB=20
PRINT_COMMAND_TIMEOUT_MS=10000
PRINT_REQUEST_TTL_MS=600000
MAX_CONCURRENT_PRINT_JOBS=1

# Kosongkan opsi yang belum diverifikasi lewat: lpoptions -p EpsonL3251 -l
PRINT_MEDIA=
PRINT_QUALITY=
PRINT_FIT_TO_PAGE=true

# Profil koneksi printer. Pilih `usb` atau `wifi` untuk memakai opsi CUPS
# per koneksi tanpa mengubah default queue di Fedora. Opsi dipisahkan koma
# dan hanya format `NamaOpsi=Nilai` yang aman diteruskan ke `lp -o`.
# Contoh L3251 Wi-Fi (verifikasi dahulu dengan `lpoptions -p EpsonL3251 -l`):
PRINT_PROFILE=wifi
PRINT_PRINTER_NAME_USB=EpsonL3251USB
PRINT_PRINTER_NAME_WIFI=EpsonL3251WiFi
PRINT_CUPS_OPTIONS_USB=
PRINT_CUPS_OPTIONS_WIFI=PageSize=4x6.Borderless,ColorModel=RGB,cupsPrintQuality=High

# Share QR lokal Fedora
# File foto/video bersifat sementara dan disimpan di RAM proses Node.js.
SHARE_TTL_HOURS=24
MAX_SHARE_UPLOAD_MB=12
MAX_CONCURRENT_SHARE_UPLOADS=2
MAX_SHARE_COUNT=24
MAX_SHARE_MEMORY_MB=128

# Batas resource HTTP server lokal
HTTP_REQUEST_TIMEOUT_MS=30000
MAX_SERVER_CONNECTIONS=50

# HTTPS lokal — hanya diperlukan jika perangkat membuka IP Fedora secara langsung.
# Kosongkan keduanya jika HTTPS diterminasi Cloudflare Tunnel/Caddy dan PUBLIC_ORIGIN
# sudah memakai https://.
# Pada Docker, simpan file di ./certs dan gunakan path /app/certs/...
# Pada runtime Node langsung, path relatif dihitung dari root repository.
# Isi keduanya atau kosongkan keduanya.
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# Hanya untuk deployment Vercel lama; tidak dipakai oleh npm run start lokal.
BLOB_READ_WRITE_TOKEN=
