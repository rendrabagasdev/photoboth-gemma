  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json && tsc -p tsconfig.server.json --noEmit",
