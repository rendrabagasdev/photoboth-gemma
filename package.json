    "@fix-webm-duration/fix": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.6.1",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.4",
    "framer-motion": "^13.1.1",
    "mediabunny": "^1.55.2",
    "mp4-muxer": "^5.2.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.3",
    "react-webcam": "^7.2.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
